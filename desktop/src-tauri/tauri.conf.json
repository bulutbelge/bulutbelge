{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BulutBelge",
  "version": "0.1.0",
  "identifier": "com.proteksistem.bulutbelge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BulutBelge",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "license": "AGPL-3.0-only",
    "licenseFile": "windows/KOSULLAR.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/man/man1/bulutbelge.1": "../../docs/uretilen/bulutbelge.1",
          "/usr/bin/bulutbelge": "linux/bulutbelge"
        }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": {
          "tr-TR": { "localePath": "windows/wix/tr-TR.wxl" },
          "en-US": {}
        }
      }
    }
  }
}
